-- Design §3. Raw messages are kept so a rule-pack update can re-parse history (O4).
-- Encrypted at rest: SQLCipher, passphrase wrapped by an AndroidKeyStore AES key (DbKey.kt).
-- Schema version = 1 + number of files in migrations/. Builds are on devices: every change to a
-- CREATE TABLE below needs a matching migrations/N.sqm, and the CREATE TABLE must end up equal
-- to what the migrations produce.

CREATE TABLE message (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    hash TEXT NOT NULL UNIQUE,          -- sha256(sender, body, received_at): exact replay guard
    sender TEXT NOT NULL,
    body TEXT NOT NULL,
    received_at INTEGER NOT NULL,       -- epoch millis, from the SMS itself
    parsed INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE tx (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    message_id INTEGER NOT NULL UNIQUE REFERENCES message(id),
    type TEXT NOT NULL,
    amount REAL NOT NULL,
    currency TEXT NOT NULL,
    merchant TEXT,
    merchant_key TEXT,                  -- normalizeMerchant(merchant); what a correction applies to
    card_last4 TEXT,
    occurred_at TEXT,                   -- ISO-ish from the message; NULL when the bank gave none
    category TEXT,
    category_reason TEXT NOT NULL,
    hidden INTEGER NOT NULL DEFAULT 0    -- removed by the user; kept so a re-import cannot bring it back
);

CREATE TABLE merchant_rule (
    merchant_key TEXT NOT NULL PRIMARY KEY,   -- normalizeMerchant()
    category TEXT NOT NULL
);

insertMessage:
INSERT OR IGNORE INTO message(hash, sender, body, received_at) VALUES (?, ?, ?, ?);

allMessages:
SELECT sender, body, received_at FROM message ORDER BY received_at;

-- Same text from the same sender within ten minutes is the same SMS: the live receiver stores
-- the network timestamp, the importer the phone's receive time, and they differ by seconds.
nearDuplicate:
SELECT COUNT(*) FROM message WHERE sender = ? AND body = ? AND received_at BETWEEN ? AND ?;

-- Repairs rows stored before nearDuplicate existed. Only with bodies kept: blank bodies would
-- all look alike.
hideDuplicateTx:
UPDATE tx SET hidden = 1 WHERE message_id IN (
    SELECT later.id FROM message later JOIN message earlier
        ON earlier.sender = later.sender AND earlier.body = later.body AND earlier.id < later.id
        AND earlier.body != '' AND abs(later.received_at - earlier.received_at) < 600000
);

unparsed:
SELECT * FROM message WHERE parsed = 0 ORDER BY received_at;

markParsed:
UPDATE message SET parsed = 1 WHERE id = ?;

-- O4: the user chose not to keep raw text. Hash stays so replay detection still works.
blankBodies:
UPDATE message SET body = '' WHERE parsed = 1 AND body != '';

insertTx:
INSERT OR IGNORE INTO tx(message_id, type, amount, currency, merchant, merchant_key, card_last4, occurred_at, category, category_reason)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

recentTx:
SELECT tx.*, message.received_at FROM tx JOIN message ON message.id = tx.message_id
WHERE tx.hidden = 0 ORDER BY message.received_at DESC LIMIT 500;

txDetail:
SELECT tx.*, message.sender, message.body, message.received_at FROM tx JOIN message ON message.id = tx.message_id WHERE tx.id = ?;

-- Distinct merchant names the dictionary does not know, most frequent first. Names only.
uncategorizedMerchants:
SELECT merchant, COUNT(*) AS n FROM tx WHERE category IS NULL AND merchant IS NOT NULL AND hidden = 0
GROUP BY merchant_key ORDER BY n DESC LIMIT 200;

setType:
UPDATE tx SET type = ? WHERE id = ?;

setHidden:
UPDATE tx SET hidden = ? WHERE id = ?;

-- A bank date after the SMS arrived is a misread (d/m/yy vs yy/m/d). New parses are guarded in
-- code; this repairs rows stored before the guard existed.
clearImplausibleDates:
UPDATE tx SET occurred_at = NULL
WHERE occurred_at > strftime('%Y-%m-%d %H:%M', (SELECT received_at / 1000 + 86400 FROM message WHERE message.id = tx.message_id), 'unixepoch');

-- Engine changed: give every raw message that never became a transaction another pass.
reopenUnread:
UPDATE message SET parsed = 0 WHERE body != '' AND id NOT IN (SELECT message_id FROM tx);

unreadable:
SELECT sender, body FROM message WHERE parsed = 1 AND body != '' AND id NOT IN (SELECT message_id FROM tx) ORDER BY received_at DESC LIMIT ?;

rules:
SELECT * FROM merchant_rule;

-- Re-derivation after a rule-pack update (design §1: the engine is pure, so history can be re-categorized).
allTxForRecategorize:
SELECT id, type, merchant, category_reason FROM tx;

setCategory:
UPDATE tx SET category = ?, category_reason = ? WHERE id = ?;

upsertRule:
INSERT OR REPLACE INTO merchant_rule(merchant_key, category) VALUES (?, ?);

-- One tap fixes every past and future transaction of that merchant (design §2.4 step 1).
applyRule:
UPDATE tx SET category = ?, category_reason = 'OVERRIDE' WHERE merchant_key = ?;
